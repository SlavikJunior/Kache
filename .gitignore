.kotlin/
/build/
local.properties
*.iml
*.DS_Store
*/out/
*/build/
# `*/build/` does not cross directory separators, so the nested consumer harness build
# directories are not matched by it and have to be listed explicitly.
verification/consumer/build/
verification/consumer-android/build/
verification/consumer-kmp/build/
verification/consumer-kmp/app/build/
verification/consumer-kmp/iosx64/build/

# Xcode: проект и Info.plist генерируются xcodegen из iosApp/project.yml.
iosApp/iosApp.xcodeproj/
iosApp/iosApp/Info.plist

# IDE / OS мусор
*.hprof
.kotlin/sessions/

# Артефакты публикации
*.module


# Инструкции агента: не часть библиотеки
/AGENTS.md

# `docs/` — рабочие материалы: архитектурные заметки, бэклог, аудит безопасности, процедура
# релиза и спеки. В репозиторий они не попадают; публичная документация — README, SECURITY.md
# и CHANGELOG.md.
/docs/

# Python-кеш утилит в tools/
__pycache__/
